{
  "$description": "Anthropic-style design tokens (DTCG format). See SKILL.md for usage and references/tokens.md for rationale on each value.",
  "color": {
    "surface": {
      "$value": "#faf9f5",
      "$type": "color",
      "$description": "Warm cream — base canvas. Never use pure white as page background."
    },
    "surface-sunken": {
      "$value": "#f3f1ea",
      "$type": "color",
      "$description": "Slightly darker cream — code blocks, table headers, muted sections."
    },
    "surface-raised": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "White — cards and modals only, paired with a 1px border."
    },
    "text": {
      "$value": "#141413",
      "$type": "color",
      "$description": "Near-black (not pure black) for primary text."
    },
    "text-muted": {
      "$value": "#6b6a64",
      "$type": "color",
      "$description": "Secondary text, captions, helper copy."
    },
    "text-faint": {
      "$value": "#b0aea5",
      "$type": "color",
      "$description": "Disabled, placeholder, meta info."
    },
    "text-on-accent": {
      "$value": "#faf9f5",
      "$type": "color",
      "$description": "Text on filled accent surfaces."
    },
    "border": {
      "$value": "#e8e6dc",
      "$type": "color",
      "$description": "Default border. The system prefers borders to shadows."
    },
    "border-strong": {
      "$value": "#c9c5b8",
      "$type": "color",
      "$description": "Stronger border for emphasis (focused inputs, hover lifts)."
    },
    "accent": {
      "$value": "#d97757",
      "$type": "color",
      "$description": "Terra cotta — signature primary accent. Use sparingly."
    },
    "accent-hover": {
      "$value": "#c4613f",
      "$type": "color",
      "$description": "Hover state for filled terra-cotta surfaces."
    },
    "accent-soft": {
      "$value": "#f4dccf",
      "$type": "color",
      "$description": "Soft terra cotta for backgrounds — banners, callouts."
    },
    "accent-blue": {
      "$value": "#6a9bcc",
      "$type": "color",
      "$description": "Mist blue — secondary accent. Cycles after orange."
    },
    "accent-blue-soft": {
      "$value": "#dbe6f1",
      "$type": "color",
      "$description": "Soft blue for info banners and tags."
    },
    "accent-green": {
      "$value": "#788c5d",
      "$type": "color",
      "$description": "Olive green — tertiary accent. Cycles after blue."
    },
    "accent-green-soft": {
      "$value": "#dde2d0",
      "$type": "color",
      "$description": "Soft green for success banners and tags."
    },
    "success": { "$value": "{color.accent-green}", "$type": "color" },
    "warning": { "$value": "{color.accent}",       "$type": "color" },
    "danger":  { "$value": "#b54545",              "$type": "color" },
    "info":    { "$value": "{color.accent-blue}",  "$type": "color" }
  },

  "font-family": {
    "heading": {
      "$value": "\"Styrene A\", \"Styrene B\", \"Poppins\", \"Helvetica Neue\", Arial, sans-serif",
      "$type": "fontFamily",
      "$description": "Geometric sans for headings. Styrene first; Poppins as licensed-free fallback."
    },
    "body": {
      "$value": "\"Tiempos Text\", \"Tiempos\", \"Lora\", Georgia, \"Times New Roman\", serif",
      "$type": "fontFamily",
      "$description": "Serif body — the most distinctive choice in this system."
    },
    "mono": {
      "$value": "\"JetBrains Mono\", \"Fira Code\", \"SF Mono\", Menlo, Consolas, monospace",
      "$type": "fontFamily"
    }
  },

  "font-size": {
    "display":  { "$value": "3.5rem",   "$type": "dimension", "$description": "Hero only" },
    "h1":       { "$value": "2.5rem",   "$type": "dimension" },
    "h2":       { "$value": "2rem",     "$type": "dimension" },
    "h3":       { "$value": "1.5rem",   "$type": "dimension" },
    "h4":       { "$value": "1.25rem",  "$type": "dimension" },
    "body-lg":  { "$value": "1.125rem", "$type": "dimension" },
    "body":     { "$value": "1rem",     "$type": "dimension" },
    "sm":       { "$value": "0.875rem", "$type": "dimension" },
    "caption":  { "$value": "0.75rem",  "$type": "dimension" }
  },

  "font-weight": {
    "regular":  { "$value": 400, "$type": "fontWeight" },
    "medium":   { "$value": 500, "$type": "fontWeight" },
    "semibold": { "$value": 600, "$type": "fontWeight", "$description": "Heaviest weight in this system. Avoid 700+." }
  },

  "line-height": {
    "display":   { "$value": 1.05, "$type": "number" },
    "h1":        { "$value": 1.1,  "$type": "number" },
    "h2":        { "$value": 1.15, "$type": "number" },
    "h3":        { "$value": 1.25, "$type": "number" },
    "body":      { "$value": 1.6,  "$type": "number" },
    "body-long": { "$value": 1.65, "$type": "number" }
  },

  "letter-spacing": {
    "display": { "$value": "-0.02em",  "$type": "dimension" },
    "h1":      { "$value": "-0.015em", "$type": "dimension" },
    "h2":      { "$value": "-0.01em",  "$type": "dimension" },
    "h3":      { "$value": "-0.005em", "$type": "dimension" },
    "body":    { "$value": "0",        "$type": "dimension" },
    "caption": { "$value": "0.02em",   "$type": "dimension" },
    "overline":{ "$value": "0.04em",   "$type": "dimension" }
  },

  "space": {
    "0":  { "$value": "0",       "$type": "dimension" },
    "1":  { "$value": "0.25rem", "$type": "dimension" },
    "2":  { "$value": "0.5rem",  "$type": "dimension" },
    "3":  { "$value": "0.75rem", "$type": "dimension" },
    "4":  { "$value": "1rem",    "$type": "dimension" },
    "5":  { "$value": "1.25rem", "$type": "dimension" },
    "6":  { "$value": "1.5rem",  "$type": "dimension" },
    "8":  { "$value": "2rem",    "$type": "dimension" },
    "10": { "$value": "2.5rem",  "$type": "dimension" },
    "12": { "$value": "3rem",    "$type": "dimension" },
    "16": { "$value": "4rem",    "$type": "dimension" },
    "20": { "$value": "5rem",    "$type": "dimension" },
    "24": { "$value": "6rem",    "$type": "dimension" },
    "32": { "$value": "8rem",    "$type": "dimension" }
  },

  "size": {
    "width-prose":     { "$value": "720px",  "$type": "dimension" },
    "width-content":   { "$value": "960px",  "$type": "dimension" },
    "width-container": { "$value": "1200px", "$type": "dimension" },
    "width-max":       { "$value": "1440px", "$type": "dimension" },
    "height-input":     { "$value": "40px", "$type": "dimension" },
    "height-input-lg":  { "$value": "48px", "$type": "dimension" },
    "height-button":    { "$value": "40px", "$type": "dimension" },
    "height-button-lg": { "$value": "48px", "$type": "dimension" },
    "height-button-sm": { "$value": "32px", "$type": "dimension" },
    "height-nav":       { "$value": "72px", "$type": "dimension" }
  },

  "radius": {
    "sm":   { "$value": "4px",   "$type": "dimension" },
    "base": { "$value": "6px",   "$type": "dimension" },
    "md":   { "$value": "8px",   "$type": "dimension" },
    "lg":   { "$value": "12px",  "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension", "$description": "Tags and status chips only." }
  },

  "shadow": {
    "sm":   { "$value": "0 1px 2px rgba(20, 20, 19, 0.04)",  "$type": "shadow" },
    "base": { "$value": "0 2px 8px rgba(20, 20, 19, 0.06)",  "$type": "shadow" },
    "lg":   { "$value": "0 8px 24px rgba(20, 20, 19, 0.08)", "$type": "shadow", "$description": "Modals only." }
  },

  "duration": {
    "fast": { "$value": "150ms", "$type": "duration" },
    "base": { "$value": "300ms", "$type": "duration" },
    "slow": { "$value": "600ms", "$type": "duration" }
  },

  "easing": {
    "out":    { "$value": "cubic-bezier(0.16, 1, 0.3, 1)",  "$type": "cubicBezier" },
    "in-out": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)", "$type": "cubicBezier" },
    "in":     { "$value": "cubic-bezier(0.5, 0, 0.75, 0)",  "$type": "cubicBezier" }
  },

  "z-index": {
    "base":     { "$value": 0,  "$type": "number" },
    "dropdown": { "$value": 10, "$type": "number" },
    "sticky":   { "$value": 20, "$type": "number" },
    "overlay":  { "$value": 30, "$type": "number" },
    "modal":    { "$value": 40, "$type": "number" },
    "toast":    { "$value": 50, "$type": "number" },
    "tooltip":  { "$value": 60, "$type": "number" }
  }
}
